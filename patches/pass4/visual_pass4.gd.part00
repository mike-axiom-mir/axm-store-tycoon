extends Node

var root: Node3D
var fine_noise: ImageTexture
var soft_noise: ImageTexture

func _ready() -> void:
	await get_tree().process_frame
	root = get_parent() as Node3D
	if root == null:
		return
	fine_noise = _make_noise_texture(64, 0.16, 13)
	soft_noise = _make_noise_texture(64, 0.08, 31)
	_tune_environment()
	_recompose_scene()
	_restyle_existing()
	_add_premium_layers()
	_polish_hud()

func _tune_environment() -> void:
	var world := root.get_node_or_null("WorldEnvironment") as WorldEnvironment
	if world and world.environment:
		var env := world.environment
		env.background_color = Color(0.50,0.66,0.82)
		env.ambient_light_color = Color(0.74,0.80,0.84)
		env.ambient_light_energy = 0.72
		env.tonemap_mode = Environment.TONE_MAPPER_FILMIC
		env.glow_enabled = true
		env.glow_intensity = 0.10
		env.adjustment_enabled = true
		env.adjustment_brightness = 1.03
		env.adjustment_contrast = 1.10
		env.adjustment_saturation = 1.07

func _recompose_scene() -> void:
	var player := root.get_node_or_null("Player") as CharacterBody3D
	if player:
		player.position = Vector3(3.65,0,4.55)
		player.rotation_degrees = Vector3(0,24,0)
		var camera := player.get_node_or_null("Camera3D") as Camera3D
		if camera:
			camera.fov = 76.0
	var shelves: Array[Node] = []
	_collect_named(root,"RetailShelf",shelves)
	if shelves.size() > 0:
		var s0 := shelves[0] as Node3D
		s0.position = Vector3(-4.15,0,-2.25)
		s0.rotation.y = PI * 0.5
		s0.scale = Vector3.ONE * 0.88
	if shelves.size() > 1:
		var s1 := shelves[1] as Node3D
		s1.position = Vector3(-4.15,0,0.05)
		s1.rotation.y = PI * 0.5
		s1.scale = Vector3.ONE * 0.88
	var counter := _find_first(root,"CheckoutCounter") as Node3D
	if counter:
		counter.position = Vector3(3.42,0,2.05)
		counter.rotation.y = -PI * 0.5
		counter.scale = Vector3.ONE * 0.92
	var feature := _find_first(root,"FeatureStand") as Node3D
	if feature:
		feature.position = Vector3(-0.20,0,-1.35)
		feature.scale = Vector3.ONE * 0.72

func _restyle_existing() -> void:
	var steel := _surface(Color(0.16,0.20,0.23),0.25,0.36,fine_noise,6.0)
	var ivory := _surface(Color(0.91,0.87,0.78),0.52,0.02,soft_noise,4.0)
	var wood := _surface(Color(0.30,0.12,0.055),0.46,0.01,fine_noise,5.0)
	var green := _surface(Color(0.045,0.17,0.145),0.33,0.05,fine_noise,5.0)
	var copper := _surface(Color(0.48,0.20,0.075),0.25,0.38,fine_noise,7.0)
	var rubber := _surface(Color(0.025,0.03,0.035),0.92,0.02,fine_noise,8.0)
	var cyan := _emissive(Color(0.10,0.76,0.86),1.35)
	var meshes: Array[MeshInstance3D] = []
	_collect_meshes(root,meshes)
	for mesh in meshes:
		match String(mesh.name):
			"ShelfBoard", "CounterTop", "PumpInset": mesh.material_override = ivory
			"Back", "LeftPost", "RightPost", "Register", "KickRail", "ColdShelf": mesh.material_override = steel
			"CounterBase", "CrateBody", "CrateTop", "StandBase": mesh.material_override = wood
			"TopTrim", "FrontAccent", "PumpStripe": mesh.material_override = copper
			"Belt", "LeftFoot", "RightFoot", "PumpBase": mesh.material_override = rubber
			"Screen", "PumpScreen": mesh.material_override = cyan
			"FridgeBody": mesh.material_override = green

func _add_premium_layers() -> void:
	var dark := _surface(Color(0.045,0.055,0.065),0.30,0.12,fine_noise,8.0)
	var wall := _surface(Color(0.76,0.73,0.66),0.70,0.01,soft_noise,4.0)
	var wood := _surface(Color(0.31,0.13,0.06),0.48,0.01,fine_noise,5.0)
	var copper := _surface(Color(0.48,0.20,0.075),0.24,0.40,fine_noise,7.0)
	var tile_a := _surface(Color(0.10,0.14,0.17),0.50,0.05,fine_noise,7.0)
	var tile_b := _surface(Color(0.15,0.19,0.22),0.46,0.06,fine_noise,7.0)
	var warm := _emissive(Color(1.0,0.79,0.52),1.65)
	var orange := _emissive(Color(0.92,0.31,0.12),0.95)
	# Premium tile skin above the structural floor.
	for tx in range(-4,5):
		for tz in range(-5,5):
			var tile_mat: Material = tile_a if ((tx + tz) % 2 == 0) else tile_b
			_box("P4Tile",Vector3(float(tx),0.026,float(tz)-0.15),Vector3(0.91,0.018,0.91),tile_mat)
	# Back wall panel rhythm and brass rail.
	_box("P4BackBand",Vector3(0,2.66,-6.03),Vector3(9.9,0.36,0.10),dark)
	_box("P4BackRail",Vector3(0,2.44,-5.98),Vector3(9.6,0.05,0.09),copper)
	for x in [-3.8,-1.9,0.0,1.9,3.8]:
		_box("P4WallPanel",Vector3(x,1.28,-5.94),Vector3(1.60,1.70,0.055),wall)
		_box("P4WallInset",Vector3(x,1.28,-5.89),Vector3(1.28,1.38,0.024),wood)
	# Linear ceiling light architecture.
	for z in [-3.8,-1.2,1.4,3.8]:
		_box("P4CeilingRail",Vector3(0,2.99,z),Vector3(6.8,0.075,0.16),dark)
		_box("P4CeilingGlow",Vector3(0,2.94,z),Vector3(5.8,0.026,0.09),warm)
		var light := OmniLight3D.new()
		light.position = Vector3(0,2.70,z)
		light.omni_range = 5.0
		light.light_color = Color(1.0,0.83,0.62)
		light.light_energy = 0.48
		root.add_child(light)
	# Shelf edge layers make the existing boxes read like manufactured fixtures.
	var shelves: Array[Node] = []
	_collect_named(root,"RetailShelf",shelves)
	for shelf_node in shelves:
		var shelf := shelf_node as Node3D
		_box_local(shelf,"P4HeaderGlow",Vector3(0,1.94,-0.015),Vector3(0.78,0.065,0.025),orange)
		_box_local(shelf,"P4LeftCap",Vector3(-0.71,0.98,0.05),Vector3(0.045,1.68,0.48),copper)
		_box_local(shelf,"P4RightCap",Vector3(0.71,0.98,0.05),Vector3(0.045,1.68,0.48),copper)
