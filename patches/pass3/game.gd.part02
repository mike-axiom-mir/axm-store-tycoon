	body.collision_layer = 1
	body.collision_mask = 0
	var shape := CollisionShape3D.new()
	var box_shape := BoxShape3D.new()
	box_shape.size = Vector3(1.55,0.18,1.45)
	shape.shape = box_shape
	shape.position = Vector3(0,0.09,0)
	body.add_child(shape)
	order_pad_holder.add_child(body)
	order_pad_label = Label3D.new()
	order_pad_label.text = "SUPPLIER PAD"
	order_pad_label.font_size = 30
	order_pad_label.modulate = Color(0.72,0.91,0.78)
	order_pad_label.position = Vector3(0,0.12,-0.72)
	order_pad_label.rotation_degrees = Vector3(-72,0,0)
	order_pad_holder.add_child(order_pad_label)
	pad.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_ON

func _create_upgrade_terminal() -> void:
	upgrade_holder = _instantiate_prop("res://assets/axm_props/upgrade_terminal/upgrade_terminal.gltf", "UpgradeTerminal", Vector3(3.35,1.08,2.84), 0.0)
	_add_prop_collision(upgrade_holder, Vector3(0.68,1.28,0.48), Vector3(0,0.64,0), "upgrade", -1)
	upgrade_label = Label3D.new()
	upgrade_label.font_size = 24
	upgrade_label.modulate = Color(0.46,0.97,0.78)
	upgrade_label.position = Vector3(0,1.47,-0.12)
	upgrade_label.rotation_degrees = Vector3(0,180,0)
	upgrade_label.text = "UPGRADES"
	upgrade_holder.add_child(upgrade_label)

func _create_shelf(pos: Vector3, rot_y: float, cooled: bool, asset_name: String) -> int:
	var path := "res://assets/axm_props/fridge/fridge.gltf" if cooled else "res://assets/axm_props/shelf/shelf.gltf"
	var holder := _instantiate_prop(path, "FridgeShelf" if cooled else "RetailShelf", pos, rot_y)
	var idx := shelf_states.size()
	var collision_size := Vector3(1.65,2.2,0.82) if cooled else Vector3(1.45,2.0,0.62)
	_add_prop_collision(holder, collision_size, Vector3(0,1.1,0), "shelf", idx)
	var visuals := Node3D.new()
	visuals.name = "ProductVisuals"
	holder.add_child(visuals)
	var browse_offset := Vector3(0,0,-0.98)
	var browse_world := holder.global_transform * browse_offset
	var state := {
		"holder": holder,
		"visuals": visuals,
		"cooled": cooled,
		"stock": {},
		"browse": browse_world,
		"asset": asset_name,
	}
	shelf_states.append(state)
	_refresh_shelf_visual(idx)
	return idx

func _build_hud() -> void:
	var layer := CanvasLayer.new()
	layer.name = "HUD"
	add_child(layer)
	var root := Control.new()
	root.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
	layer.add_child(root)

	var stats_panel := _hud_panel(Vector2(18,18), Vector2(330,116))
	root.add_child(stats_panel)
	stats_label = Label.new()
	stats_label.position = Vector2(14,10)
	stats_label.size = Vector2(300,96)
	stats_label.add_theme_font_size_override("font_size", 20)
	stats_panel.add_child(stats_label)

	var inv_panel := _hud_panel(Vector2(930,18), Vector2(332,150))
	inv_panel.set_anchors_preset(Control.PRESET_TOP_RIGHT)
	inv_panel.position = Vector2(-350,18)
	root.add_child(inv_panel)
	inventory_label = Label.new()
	inventory_label.position = Vector2(12,10)
	inventory_label.size = Vector2(306,130)
	inventory_label.horizontal_alignment = HORIZONTAL_ALIGNMENT_RIGHT
	inventory_label.add_theme_font_size_override("font_size", 17)
	inv_panel.add_child(inventory_label)

	event_label = Label.new()
	event_label.set_anchors_preset(Control.PRESET_TOP_WIDE)
	event_label.position = Vector2(355,20)
	event_label.size = Vector2(570,46)
	event_label.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	event_label.add_theme_font_size_override("font_size", 20)
	event_label.add_theme_color_override("font_color", Color(0.94,0.84,0.51))
	root.add_child(event_label)

	crosshair = Label.new()
	crosshair.text = "+"
	crosshair.set_anchors_preset(Control.PRESET_CENTER)
	crosshair.position = Vector2(-10,-17)
	crosshair.size = Vector2(20,34)
	crosshair.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	crosshair.add_theme_font_size_override("font_size", 24)
	crosshair.modulate = Color(1,1,1,0.72)
	root.add_child(crosshair)

	target_label = Label.new()
	target_label.set_anchors_preset(Control.PRESET_CENTER)
	target_label.position = Vector2(-230,31)
	target_label.size = Vector2(460,55)
	target_label.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	target_label.add_theme_font_size_override("font_size", 17)
	target_label.add_theme_color_override("font_color", Color(0.88,0.94,0.90))
	root.add_child(target_label)

	var prompt_panel := _hud_panel(Vector2.ZERO, Vector2(640,78))
	prompt_panel.set_anchors_preset(Control.PRESET_CENTER_BOTTOM)
	prompt_panel.position = Vector2(-320,-105)
	root.add_child(prompt_panel)
	prompt_label = Label.new()
	prompt_label.position = Vector2(14,8)
	prompt_label.size = Vector2(612,62)
	prompt_label.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	prompt_label.vertical_alignment = VERTICAL_ALIGNMENT_CENTER
	prompt_label.add_theme_font_size_override("font_size", 18)
	prompt_panel.add_child(prompt_label)

	toast_label = Label.new()
	toast_label.set_anchors_preset(Control.PRESET_CENTER_TOP)
	toast_label.position = Vector2(-360,74)
	toast_label.size = Vector2(720,60)
	toast_label.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	toast_label.vertical_alignment = VERTICAL_ALIGNMENT_CENTER
	toast_label.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
	toast_label.add_theme_font_size_override("font_size", 18)
	toast_label.add_theme_color_override("font_color", Color(0.96,0.92,0.76))
	root.add_child(toast_label)

	var controls := Label.new()
	controls.set_anchors_preset(Control.PRESET_BOTTOM_LEFT)
	controls.position = Vector2(18,-55)
	controls.size = Vector2(700,42)
	controls.text = "WASD / Left stick move   •   Mouse / Right stick look   •   E / A interact   •   Q / X discount   •   R / Y cycle stock"
	controls.add_theme_font_size_override("font_size", 13)
	controls.modulate = Color(1,1,1,0.56)
	root.add_child(controls)

	day_summary_panel = _hud_panel(Vector2.ZERO, Vector2(560,290))
	day_summary_panel.set_anchors_preset(Control.PRESET_CENTER)
	day_summary_panel.position = Vector2(-280,-145)
	day_summary_panel.visible = false
	root.add_child(day_summary_panel)
	day_summary_label = Label.new()
	day_summary_label.position = Vector2(24,20)
	day_summary_label.size = Vector2(512,250)
	day_summary_label.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	day_summary_label.vertical_alignment = VERTICAL_ALIGNMENT_CENTER
	day_summary_label.add_theme_font_size_override("font_size", 23)
	day_summary_panel.add_child(day_summary_label)

func _hud_panel(pos: Vector2, size: Vector2) -> PanelContainer:
	var panel := PanelContainer.new()
	panel.position = pos
	panel.size = size
	var style := StyleBoxFlat.new()
	style.bg_color = Color(0.035,0.045,0.042,0.86)
	style.border_color = Color(0.22,0.45,0.34,0.72)
	style.set_border_width_all(1)
	style.set_corner_radius_all(12)
	panel.add_theme_stylebox_override("panel", style)
	return panel

func _material(color: Color, roughness: float, metallic: float = 0.0) -> StandardMaterial3D:
	var material := StandardMaterial3D.new()
	material.albedo_color = color
	material.roughness = roughness
	material.metallic = metallic
	return material

func _add_box_visual(node_name: String, pos: Vector3, size: Vector3, material: Material) -> MeshInstance3D:
	var mesh := BoxMesh.new()
	mesh.size = size
	var instance := MeshInstance3D.new()
	instance.name = node_name
	instance.mesh = mesh
	instance.material_override = material
	instance.position = pos
	add_child(instance)
	return instance

func _add_box_visual_local(parent: Node3D, node_name: String, pos: Vector3, size: Vector3, material: Material) -> MeshInstance3D:
	var mesh := BoxMesh.new()
	mesh.size = size
