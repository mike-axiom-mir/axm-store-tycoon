var backroom: Array[Dictionary] = []
var shelf_states: Array[Dictionary] = []
var customers: Array = []
var upgrades := {
	"lighting": false,
	"side_shelf": false,
	"fridge": false,
	"neon": false,
	"decor": false,
	"scanner": false,
}
var upgrade_plan: Array[Dictionary] = []

var cash := 72.0
var reputation := 6.0
var day := 1
var game_minutes := DAY_START
var waste_value := 0.0
var total_sales := 0
var total_revenue := 0.0
var minute_accumulator := 0.0
var customer_timer := 3.0
var day_transition_timer := 0.0
var shop_open := true
var delivery_pending: Array[Dictionary] = []
var delivery_crate_holder: Node3D = null
var selected_backroom := 0
var current_event := "Quiet start"
var event_customer_mult := 1.0
var event_demand_tag := ""
var event_order_discount := 0.0
var day_start_cash := 0.0
var day_start_waste := 0.0
var day_start_sales := 0

var stats_label: Label
var inventory_label: Label
var event_label: Label
var prompt_label: Label
var target_label: Label
var toast_label: Label
var day_summary_panel: PanelContainer
var day_summary_label: Label
var toast_timer := 0.0
var crosshair: Label
var audio_player: AudioStreamPlayer

var order_pad_holder: Node3D
var order_pad_label: Label3D
var upgrade_holder: Node3D
var upgrade_label: Label3D
var store_sign_label: Label3D
var store_sign_panel: MeshInstance3D
var decor_root: Node3D
var upgraded_lights_root: Node3D

var mat_wall: StandardMaterial3D
var mat_floor: StandardMaterial3D
var mat_dark: StandardMaterial3D
var mat_green: StandardMaterial3D
var mat_glass: StandardMaterial3D
var mat_cream: StandardMaterial3D
var mat_grout: StandardMaterial3D
var mat_concrete: StandardMaterial3D
var mat_asphalt: StandardMaterial3D
var mat_line: StandardMaterial3D
var mat_trim: StandardMaterial3D
var mat_warning: StandardMaterial3D
var mat_rubber: StandardMaterial3D
var mat_neon: StandardMaterial3D

func _ready() -> void:
	rng.randomize()
	audio_player = AudioStreamPlayer.new()
	audio_player.name = "SFX"
	add_child(audio_player)
	_init_products()
	_init_upgrades()
	_init_materials()
	_build_world_environment()
	_build_store_shell()
	_build_store_fixtures()
	_build_hud()
	player.interact_pressed.connect(_interact)
	player.discount_pressed.connect(_discount_target)
	player.cycle_pressed.connect(_cycle_selected_stock)
	day_start_cash = cash
	day_start_waste = waste_value
	day_start_sales = total_sales
	_apply_day_event(true)
	_toast("Your tiny store is empty. Order a mystery supplier crate.", 5.0)
	_update_all_ui()

func _process(delta: float) -> void:
	if toast_timer > 0.0:
		toast_timer -= delta
		if toast_timer <= 0.0:
			toast_label.text = ""
	if day_transition_timer > 0.0:
		day_transition_timer -= delta
		if day_transition_timer <= 0.0:
			_start_next_day()
		_update_interaction_ui()
		return
	if shop_open:
		minute_accumulator += delta * GAME_MINUTES_PER_SECOND
		if minute_accumulator >= 1.0:
			var elapsed := int(floor(minute_accumulator))
			minute_accumulator -= float(elapsed)
			_advance_minutes(elapsed)
		customer_timer -= delta
		if customer_timer <= 0.0:
			_try_spawn_customer()
			customer_timer = _next_customer_interval()
	_update_interaction_ui()
	_update_stats_ui()

