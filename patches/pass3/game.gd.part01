	mat_trim = _material(Color(0.64,0.16,0.10), 0.48, 0.04)
	mat_warning = _material(Color(0.92,0.56,0.10), 0.64)
	mat_rubber = _material(Color(0.05,0.05,0.055), 0.98)
	mat_glass = _material(Color(0.69,0.83,0.90,0.20), 0.06)
	mat_glass.transparency = BaseMaterial3D.TRANSPARENCY_ALPHA
	mat_glass.metallic = 0.02
	mat_glass.emission_enabled = true
	mat_glass.emission = Color(0.09,0.16,0.20)
	mat_glass.emission_energy_multiplier = 0.25
	mat_neon = _material(Color(0.86,0.30,0.18), 0.16)
	mat_neon.emission_enabled = true
	mat_neon.emission = Color(1.0,0.46,0.22)
	mat_neon.emission_energy_multiplier = 1.2

func _build_world_environment() -> void:
	var world := WorldEnvironment.new()
	world.name = "WorldEnvironment"
	var environment := Environment.new()
	environment.background_mode = Environment.BG_COLOR
	environment.background_color = Color(0.53,0.67,0.81)
	environment.ambient_light_source = Environment.AMBIENT_SOURCE_COLOR
	environment.ambient_light_color = Color(0.72,0.79,0.82)
	environment.ambient_light_energy = 0.68
	environment.tonemap_mode = Environment.TONE_MAPPER_FILMIC
	environment.glow_enabled = true
	environment.glow_intensity = 0.06
	world.environment = environment
	add_child(world)
	var sun := DirectionalLight3D.new()
	sun.name = "ExteriorSoftLight"
	sun.rotation_degrees = Vector3(-52,-34,0)
	sun.light_color = Color(0.82,0.88,0.95)
	sun.light_energy = 0.95
	sun.shadow_enabled = true
	add_child(sun)
	var fill := DirectionalLight3D.new()
	fill.name = "WarmStoreBounce"
	fill.rotation_degrees = Vector3(-75,145,0)
	fill.light_color = Color(1.0,0.90,0.76)
	fill.light_energy = 0.12
	fill.shadow_enabled = false
	add_child(fill)
	upgraded_lights_root = Node3D.new()
	upgraded_lights_root.name = "UpgradeableLights"
	add_child(upgraded_lights_root)
	for pos in [Vector3(-2.8,2.75,-1.0),Vector3(-0.2,2.75,-1.0),Vector3(2.4,2.75,-1.0),Vector3(-1.9,2.75,2.0),Vector3(1.2,2.75,2.0)]:
		var light := OmniLight3D.new()
		light.position = pos
		light.omni_range = 6.4
		light.light_color = Color(0.99,0.89,0.72)
		light.light_energy = 0.78
		light.shadow_enabled = false
		add_child(light)

func _build_store_shell() -> void:
	_add_box_static("Floor", Vector3(0,-0.11,0), Vector3(10.6,0.22,12.6), mat_floor)
	for x in range(-4,5):
		_add_box_visual("TileLineX", Vector3(float(x),0.011,-0.2), Vector3(0.022,0.015,10.8), mat_grout)
	for z in range(-5,6):
		_add_box_visual("TileLineZ", Vector3(0,0.012,float(z) - 0.2), Vector3(9.9,0.016,0.022), mat_grout)
	_add_box_static("WallLeft", Vector3(-5.2,1.55,-0.15), Vector3(0.24,3.1,12.3), mat_wall)
	_add_box_static("WallRight", Vector3(5.2,1.55,-0.15), Vector3(0.24,3.1,12.3), mat_wall)
	_add_box_static("WallBack", Vector3(0,1.55,-6.2), Vector3(10.6,3.1,0.24), mat_wall)
	_add_box_visual("Ceiling", Vector3(0,3.12,-0.15), Vector3(10.6,0.12,12.3), _material(Color(0.66,0.66,0.62),0.95))
	_add_box_visual("InteriorBand", Vector3(0,2.45,-6.0), Vector3(10.1,0.22,0.08), mat_trim)
	# Front storefront.
	_add_box_static("FrontLeftLow", Vector3(-3.15,0.48,5.95), Vector3(3.9,0.96,0.22), mat_green)
	_add_box_static("FrontRightLow", Vector3(3.15,0.48,5.95), Vector3(3.9,0.96,0.22), mat_green)
	_add_box_static("FrontHeader", Vector3(0,2.82,5.95), Vector3(10.6,0.52,0.24), mat_dark)
	_add_box_visual("Awning", Vector3(0,2.48,6.30), Vector3(7.8,0.10,1.18), mat_trim)
	_add_box_static("FrontPillarL", Vector3(-1.18,1.65,5.95), Vector3(0.18,2.25,0.24), mat_dark)
	_add_box_static("FrontPillarR", Vector3(1.18,1.65,5.95), Vector3(0.18,2.25,0.24), mat_dark)
	_add_box_visual("GlassL", Vector3(-3.15,1.72,5.86), Vector3(3.72,1.85,0.055), mat_glass)
	_add_box_visual("GlassR", Vector3(3.15,1.72,5.86), Vector3(3.72,1.85,0.055), mat_glass)
	_add_box_visual("DoorGlass", Vector3(0,1.52,5.88), Vector3(2.05,2.05,0.055), mat_glass)
	_add_box_visual("DoorKick", Vector3(0,0.34,5.89), Vector3(2.05,0.30,0.07), mat_dark)
	_add_box_visual("DoorFrameTop", Vector3(0,2.56,5.90), Vector3(2.12,0.08,0.08), mat_dark)
	_add_box_visual("DoorFrameL", Vector3(-1.03,1.48,5.90), Vector3(0.08,2.10,0.08), mat_dark)
	_add_box_visual("DoorFrameR", Vector3(1.03,1.48,5.90), Vector3(0.08,2.10,0.08), mat_dark)
	# Exterior forecourt and road.
	_add_box_visual("Forecourt", Vector3(0,-0.09,7.60), Vector3(12.0,0.18,3.5), mat_concrete)
	_add_box_visual("Street", Vector3(0,-0.12,11.1), Vector3(16.0,0.18,4.4), mat_asphalt)
	_add_box_visual("Curb", Vector3(0,0.05,9.30), Vector3(12.0,0.12,0.18), _material(Color(0.83,0.82,0.78),0.92))
	for x in [-3.6,-1.0,1.6,4.2]:
		_add_box_visual("ParkingLine", Vector3(x,0.0,8.2), Vector3(0.12,0.018,1.55), mat_line)
	for x in [-3.4,0.0,3.4]:
		_add_box_visual("RoadMark", Vector3(x,0.0,10.9), Vector3(1.65,0.018,0.10), mat_line)
	_add_box_visual("WelcomeMat", Vector3(0,0.01,4.72), Vector3(2.35,0.03,1.05), mat_rubber)
	_build_store_sign()
	_build_exterior_props()

func _build_store_sign() -> void:
	store_sign_panel = _add_box_visual("StoreSignPanel", Vector3(0,2.73,5.60), Vector3(4.2,0.54,0.12), mat_neon)
	var under_glow := _add_box_visual("StoreSignGlow", Vector3(0,2.46,5.63), Vector3(4.65,0.06,0.16), mat_neon)
	under_glow.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
	store_sign_label = Label3D.new()
	store_sign_label.name = "StoreSignText"
	store_sign_label.text = "AXM MINI MART"
	store_sign_label.font_size = 52
	store_sign_label.modulate = Color(1.0,0.93,0.80)
	store_sign_label.position = Vector3(0,2.72,5.53)
	store_sign_label.rotation_degrees = Vector3(0,180,0)
	store_sign_label.outline_size = 8
	add_child(store_sign_label)

func _build_exterior_props() -> void:
	var pump := _instantiate_prop("", "GasPump", Vector3(3.2,0,7.82), 0.0)
	_add_prop_collision(pump, Vector3(0.92,2.2,0.92), Vector3(0,1.1,0), "pump", -1)
	var trash := _instantiate_prop("", "TrashBin", Vector3(-4.25,0,7.22), 0.0)
	trash.scale = Vector3.ONE * 0.95
	var planter := _instantiate_prop("", "Planter", Vector3(-2.8,0,7.14), 0.0)
	planter.scale = Vector3.ONE * 1.1
	var stop := _add_box_visual("WheelStop", Vector3(2.15,0.10,8.36), Vector3(1.45,0.20,0.32), _material(Color(0.92,0.92,0.86),0.88))
	stop.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_ON
	var banner := Label3D.new()
	banner.name = "Banner"
	banner.text = "OPEN 24/7"
	banner.font_size = 34
	banner.modulate = Color(1.0,0.93,0.72)
	banner.position = Vector3(-3.95,2.18,5.46)
	banner.rotation_degrees = Vector3(0,180,0)
	banner.outline_size = 6
	add_child(banner)

func _build_store_fixtures() -> void:
	_create_shelf(Vector3(-3.75,0,-1.65), PI * 0.5, false, "shelf")
	_create_shelf(Vector3(-3.75,0,0.95), PI * 0.5, false, "shelf")
	var counter := _instantiate_prop("res://assets/axm_props/counter/counter.gltf", "CheckoutCounter", Vector3(2.95,0,2.55), -PI * 0.5)
	_add_prop_collision(counter, Vector3(1.0,1.15,2.45), Vector3(0,0.58,0), "counter", -1)
	_create_order_pad()
	_create_upgrade_terminal()
	var feature_endcap := _instantiate_prop("", "FeatureStand", Vector3(0.55,0,0.20), 0.0)
	feature_endcap.scale = Vector3.ONE * 0.95
	decor_root = Node3D.new()
	decor_root.name = "DecorUpgrade"
	add_child(decor_root)

func _create_order_pad() -> void:
	order_pad_holder = Node3D.new()
	order_pad_holder.name = "SupplierPad"
	order_pad_holder.position = Vector3(-3.65,0,3.25)
	add_child(order_pad_holder)
	var pad := _add_box_visual_local(order_pad_holder, "Pad", Vector3(0,0.055,0), Vector3(1.55,0.11,1.45), _material(Color(0.17,0.25,0.21),0.68))
	var body := StaticBody3D.new()
	body.name = "SupplierPadInteract"
	body.set_meta("interact_kind", "order")
